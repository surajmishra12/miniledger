{
  "name": "@miniledger/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pure contracts, validation and formatting shared by the MiniLedger API and app.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=neutral --format=esm --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
